        <mesh filename="file://$(find a1_champ)/meshes/hip.dae" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder length="0.04" radius="0.046" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.003311 0.000635 3.1e-05" />
      <mass value="0.696" />
      <inertia ixx="0.000469246" ixy="9.409e-06" ixz="3.42e-07" iyy="0.00080749" iyz="-4.66e-07" izz="0.000552929" />
    </inertial>
  </link>
  <joint name="RL_hip_fixed" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.081 0" />
    <parent link="RL_hip" />
    <child link="RL_thigh_shoulder" />
  </joint>
  
  <link name="RL_thigh_shoulder">
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 0 0" />
      <geometry>
        <cylinder length="0.032" radius="0.041" />
      </geometry>
    </collision>
  </link>
  <joint name="RL_thigh_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0.0838 0" />
    <parent link="RL_hip" />
    <child link="RL_thigh" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.2" />
    <limit effort="33.5" lower="-1.0471975512" upper="4.18879020479" velocity="21" />
  </joint>
  <link name="RL_thigh">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="file://$(find a1_champ)/meshes/thigh.dae" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="0 0 -0.1" />
      <geometry>
        <box size="0.2 0.0245 0.034" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.003237 -0.022327 -0.027326" />
      <mass value="1.013" />
      <inertia ixx="0.005529065" ixy="4.825e-06" ixz="0.000343869" iyy="0.005139339" iyz="2.2448e-05" izz="0.001367788" />
    </inertial>
  </link>
  <joint name="RL_calf_joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 -0.2" />
    <parent link="RL_thigh" />
    <child link="RL_calf" />
    <axis xyz="0 1 0" />
    <dynamics damping="0.01" friction="0.2" />
    <limit effort="33.5" lower="-2.69653369433" upper="-0.916297857297" velocity="21" />
  </joint>
  <link name="RL_calf">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="file://$(find a1_champ)/meshes/calf.dae" scale="1 1 1" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="0 0 -0.1" />
      <geometry>
        <box size="0.2 0.016 0.016" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0.006435 0.0 -0.107388" />
      <mass value="0.166" />
      <inertia ixx="0.002997972" ixy="0.0" ixz="-0.000141163" iyy="0.003014022" iyz="0.0" izz="3.2426e-05" />
    </inertial>
  </link>
  <joint name="RL_foot_fixed" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.2" />
    <parent link="RL_calf" />
    <child link="RL_foot" />
  </joint>
  <link name="RL_foot">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <sphere radius="0.01" />
      </geometry>
      <material name="orange" />
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <sphere radius="0.02" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.06" />
      <inertia ixx="9.6e-06" ixy="0.0" ixz="0.0" iyy="9.6e-06" iyz="0.0" izz="9.6e-06" />
    </inertial>
  </link>
  
  <xacro:arg name="robot_ns" default="a1_1"/>
  <xacro:arg name="ros_control_yaml" default=""/>

  <xacro:arg name="effort_state" default="false"/>
  <ros2_control name="a1_system" type="system">
    <hardware>
      <plugin>ign_ros2_control/IgnitionSystem</plugin>
    </hardware>
    <joint name="FL_hip_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="FL_thigh_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">1.0472</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="FL_calf_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">-2.0944</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="FR_hip_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="FR_thigh_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">1.0472</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="FR_calf_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">-2.0944</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="RL_hip_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="RL_thigh_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">1.0472</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="RL_calf_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">-2.0944</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="RR_hip_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">0.0</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="RR_thigh_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">1.0472</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
    <joint name="RR_calf_joint">
      <command_interface name="effort"><xacro:if value="$(arg effort_state)"><param name="min">-33.5</param><param name="max">33.5</param></xacro:if></command_interface>
      <state_interface name="position"><param name="initial_value">-2.0944</param></state_interface>
      <state_interface name="velocity"/><xacro:if value="$(arg effort_state)"><state_interface name="effort"/></xacro:if>
    </joint>
  </ros2_control>

  <gazebo>
    <plugin filename="ign_ros2_control-system" name="ign_ros2_control::IgnitionROS2ControlPlugin">
      <parameters>$(arg ros_control_yaml)</parameters>
      <ros><namespace>/$(arg robot_ns)</namespace></ros>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/$(arg robot_ns)/odom/ground_truth</odom_topic>
      <odom_publish_frequency>10</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/$(arg robot_ns)/imu/data</topic>
      <ignition_frame_id>imu_link</ignition_frame_id>
      <imu><orientation_reference_frame><localization>ENU</localization></orientation_reference_frame></imu>
    </sensor>
  </gazebo>

  <link name="lidar_link">
    <inertial><mass value="0.05"/><inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/></inertial>
    <visual><geometry><cylinder radius="0.03" length="0.04"/></geometry></visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="trunk"/><child link="lidar_link"/>
    <origin xyz="0.0 0.0 0.09" rpy="0 0 0"/>
  </joint>
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>10</update_rate>
      <topic>/$(arg robot_ns)/scan</topic>
      <ignition_frame_id>lidar_link</ignition_frame_id>
      <ray>
        <scan><horizontal>
          <samples>360</samples><resolution>1</resolution>
          <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
        </horizontal></scan>
        <range><min>0.15</min><max>10.0</max><resolution>0.01</resolution></range>
      </ray>
    </sensor>
  </gazebo>

  <link name="camera_link">
    <inertial><mass value="0.02"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual><geometry><box size="0.02 0.05 0.02"/></geometry></visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="trunk"/><child link="camera_link"/>
    <origin xyz="0.29 0.0 0.0" rpy="0 0 0"/>
  </joint>
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>2</update_rate>
      <topic>/$(arg robot_ns)/front_camera/image_raw</topic>
      <ignition_frame_id>camera_link</ignition_frame_id>
      <camera>
        <horizontal_fov>1.8</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.05</near><far>15</far></clip>
      </camera>
    </sensor>
  </gazebo>
  <link name="terrain_camera_link">
    <inertial><mass value="0.02"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
    <visual><geometry><box size="0.02 0.06 0.02"/></geometry></visual>
  </link>
  <joint name="terrain_camera_joint" type="fixed">
    <parent link="trunk"/><child link="terrain_camera_link"/>
    <origin xyz="0.29 0.0 0.04" rpy="0 0.6981 0"/>
  </joint>
  <link name="terrain_camera_optical"/>
  <joint name="terrain_camera_optical_joint" type="fixed">
    <parent link="terrain_camera_link"/><child link="terrain_camera_optical"/>
    <origin xyz="0 0 0" rpy="-1.5708 0 -1.5708"/>
  </joint>
  <gazebo reference="terrain_camera_link">
    <sensor name="terrain_camera" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>false</visualize>
      <update_rate>5</update_rate>
      <topic>/$(arg robot_ns)/terrain_camera/depth</topic>
      <ignition_frame_id>terrain_camera_link</ignition_frame_id>
      <ray>
        <scan>
          <horizontal><samples>160</samples><resolution>1</resolution><min_angle>-0.759</min_angle><max_angle>0.759</max_angle></horizontal>
          <vertical><samples>120</samples><resolution>1</resolution><min_angle>-0.61</min_angle><max_angle>0.61</max_angle></vertical>
        </scan>
        <range><min>0.1</min><max>4.0</max><resolution>0.01</resolution></range>
      </ray>
    </sensor>
  </gazebo>
</robot>
