Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 14
    - Class: rviz_default_plugins/Map
      Name: Map (SLAM)
      Enabled: true
      Topic:
        Value: /NS/map
        Depth: 1
        Durability Policy: Transient Local
        Reliability Policy: Reliable
        History Policy: Keep Last
      Color Scheme: map
      Alpha: 0.8
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /NS/scan
        Depth: 5
        Reliability Policy: Best Effort
        History Policy: Keep Last
      Size (m): 0.05
      Style: Flat Squares
      Color Transformer: FlatColor
      Color: 255; 0; 0
    - Class: rviz_default_plugins/RobotModel
      Name: Robot
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /NS/robot_description
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Path
      Name: Nav path
      Enabled: true
      Topic:
        Value: /NS/nav_executor/path
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color: 0; 120; 255
      Line Width: 0.05
      Line Style: Billboards
    - Class: rviz_default_plugins/MarkerArray
      Name: Survivors
      Enabled: true
      Topic:
        Value: /NS/survivor_markers
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Image
      Name: Front camera
      Enabled: true
      Topic:
        Value: /NS/front_camera/image_raw
        Depth: 1
        Reliability Policy: Best Effort
        History Policy: Keep Last
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 10
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 45
      X: 0
      Y: 0
      Angle: 0
Window Geometry:
  Width: 900
  Height: 700
  X: XPOS
  Y: 0
